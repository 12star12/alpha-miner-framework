# 复制成 .env 再填。这个文件本身不要提交到 GitHub。
# 注意：.env 一定写进 .gitignore，账号密码别外泄。

# ---- 世坤 BRAIN 账号（就是你平时登录 platform.worldquantbrain.com 的账号）
WQ_EMAIL=
WQ_PASS=

# ---- 免费 LLM（不用 LLM 可以留空，rules 模式照样跑）
# 智谱 GLM-4-Flash：永久免费、30 并发、国内直连
# 注册：https://open.bigmodel.cn  →  API Keys 页面复制
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# 备选（同样免费，二选一）：
# 硅基流动：LLM_BASE_URL=https://api.siliconflow.cn/v1
#           LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
